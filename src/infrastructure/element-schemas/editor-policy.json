{
  "common": {
    "attributes": [
      {
        "key": "developerComment",
        "label": "Комментарий для разработки",
        "placeholder": "Добавьте описание",
        "multiline": true
      }
    ]
  },
  "elements": [
    {
      "kind": "list-item",
      "label": "List item",
      "category": "Сценарий",
      "description": "Строка списка",
      "card": { "title": "primaryText", "subtitle": "secondaryText", "icon": "leftAtom" },
      "defaults": { "primaryText": "Новый элемент", "tertiaryText": "" },
      "attributes": [
        {
          "key": "primaryText",
          "label": "Название",
          "required": true,
          "placeholder": "Например, Задать вопрос"
        },
        {
          "key": "secondaryText",
          "label": "Дополнительный текст",
          "placeholder": "Например, По методологии"
        },
        {
          "key": "tertiaryText",
          "label": "Третий текст",
          "placeholder": "Например, Ответ за 2 дня",
          "hidden": true
        },
        { "key": "leftAtom", "label": "Иконка" },
        { "key": "linkHref", "label": "Внешняя ссылка", "placeholder": "https://…" },
        { "key": "availability", "label": "Доступность на платформе", "editor": "chips", "toggle": true }
      ]
    },
    {
      "kind": "widget-card",
      "label": "Widget card",
      "category": "Сценарий",
      "description": "Карточка-виджет",
      "card": { "title": "title", "subtitle": "subtitle", "icon": "icon" },
      "defaults": { "title": "Новый элемент" },
      "attributes": [
        { "key": "title", "label": "Название", "required": true, "placeholder": "Например, Мои заявки" },
        { "key": "subtitle", "label": "Дополнительный текст", "placeholder": "Например, Статусы и сроки" },
        { "key": "icon", "label": "Иконка" },
        { "key": "href", "label": "Внешняя ссылка", "placeholder": "https://…" },
        { "key": "availability", "label": "Доступность на платформе", "editor": "chips", "toggle": true }
      ]
    },
    {
      "kind": "comment",
      "category": "Комментарий",
      "description": "Заметка на канвасе для разработчика",
      "card": { "title": "text", "badge": "audience" },
      "defaults": { "text": "Комментарий", "audience": "Разработчику" },
      "attributes": [
        {
          "key": "text",
          "label": "Текст комментария",
          "placeholder": "Что нужно знать разработчику",
          "multiline": true
        },
        { "key": "audience", "label": "Для кого", "helperText": "Показывается бейджем внизу карточки" },
        { "key": "developerComment", "hidden": true }
      ]
    },
    {
      "kind": "text-field",
      "label": "Text field",
      "category": "Форма",
      "description": "Поле для ввода информации пользователем",
      "card": { "title": "label", "subtitle": "placeholder" },
      "defaults": { "label": "Текстовое поле" },
      "attributes": [
        { "key": "label", "label": "Название поля", "required": true, "placeholder": "Например, Вопрос" },
        {
          "key": "placeholder",
          "label": "Плейсхолдер",
          "required": true,
          "placeholder": "Например, Добавьте описание"
        },
        { "key": "required", "label": "Обязательность поля" },
        { "key": "multiline", "label": "Многострочное" },
        { "key": "counter", "label": "Ограничение символов", "toggle": true },
        { "key": "helperText", "label": "Подсказка под полем", "multiline": true, "toggle": true },
        { "key": "tooltipTextIcon", "label": "Подсказка иконкой", "multiline": true, "toggle": true },
        { "key": "icon", "label": "Иконка", "hidden": true }
      ]
    },
    {
      "kind": "alert",
      "label": "Alert",
      "category": "Форма",
      "description": "Информационное сообщение",
      "card": { "title": "label" },
      "defaults": { "label": "Информационный блок", "variant": "info" },
      "attributes": [
        {
          "key": "label",
          "label": "Текст",
          "required": true,
          "placeholder": "Текст блока",
          "multiline": true
        },
        {
          "key": "variant",
          "label": "Вид",
          "section": "Тип",
          "options": [
            { "value": "info", "label": "Информация" },
            { "value": "warning", "label": "Предупреждение" },
            { "value": "success", "label": "Успех" },
            { "value": "danger", "label": "Ошибка" }
          ]
        }
      ]
    },
    {
      "kind": "date-range-field-picker",
      "label": "Date period",
      "category": "Форма",
      "description": "Выбор периода дат",
      "card": { "title": "label", "subtitle": "placeholder" },
      "defaults": { "label": "Период" },
      "attributes": [
        { "key": "label", "label": "Название", "required": true, "placeholder": "Например, Период действия" },
        { "key": "placeholder", "label": "Подсказка внутри поля" },
        { "key": "helperText", "label": "Подпись под полем" },
        { "key": "required", "label": "Обязательное поле", "section": "Настройки" },
        { "key": "disablePast", "label": "Запрет прошедших дат", "section": "Настройки" },
        { "key": "disableFuture", "label": "Запрет будущих дат", "section": "Настройки" }
      ]
    },
    {
      "kind": "attachment",
      "label": "Attachment",
      "category": "Форма",
      "description": "Поле загрузки файлов (одно на шаг формы)",
      "card": { "title": "label" },
      "defaults": { "label": "Файл" },
      "attributes": [
        {
          "key": "label",
          "label": "Название",
          "required": true,
          "placeholder": "Например, Справка о доходах"
        },
        { "key": "description", "label": "Описание" },
        {
          "key": "validExtensions",
          "label": "Типы файлов",
          "helperText": "Расширение на строку: pdf, png"
        },
        { "key": "maxFiles", "label": "Максимум файлов" },
        { "key": "required", "label": "Обязательное поле", "section": "Настройки" },
        { "key": "multiple", "label": "Несколько файлов", "section": "Настройки" }
      ]
    },
    {
      "kind": "checkbox",
      "label": "Checkbox",
      "category": "Форма",
      "description": "Флажок согласия/подтверждения",
      "card": { "title": "label" },
      "defaults": { "label": "Чекбокс" },
      "attributes": [
        {
          "key": "label",
          "label": "Название",
          "required": true,
          "placeholder": "Например, Согласен с условиями"
        },
        { "key": "helperText", "label": "Подпись под полем" },
        { "key": "required", "label": "Обязательное поле", "section": "Настройки" }
      ]
    },
    {
      "kind": "select",
      "label": "Selection list",
      "category": "Форма",
      "description": "Выбор одного или нескольких значений из списка",
      "card": {
        "title": "label",
        "chips": [
          {
            "key": "groupType",
            "labels": { "radio": "Radio", "checkbox": "Checkbox", "select": "Select", "chips": "Chips" }
          },
          { "key": "required", "label": "Обязательно", "tone": "error" },
          { "key": "dynamicContent", "label": "Дин. контент" },
          { "key": "multiselect", "label": "Ед. выбор", "when": false },
          { "key": "search", "label": "Поиск" },
          { "key": "optionsSource", "labels": { "file": "Файлом", "manual": "Вручную", "text": "Списком" } }
        ]
      },
      "defaults": { "label": "Список", "options": [], "groupType": "select", "optionsSource": "manual" },
      "attributes": [
        {
          "key": "label",
          "label": "Название поля",
          "required": true,
          "placeholder": "Например, С чем связана ошибка"
        },
        {
          "key": "placeholder",
          "label": "Подсказка внутри поля",
          "visibleWhen": { "key": "groupType", "equals": "select" }
        },
        {
          "key": "groupType",
          "label": "Тип группы",
          "section": "Тип группы",
          "editor": "switches",
          "required": true,
          "options": [
            {
              "value": "radio",
              "label": "Радио (Radio)",
              "hint": "Один вариант из нескольких, все видны сразу; реализует разработчик"
            },
            {
              "value": "checkbox",
              "label": "Чекбокс (Checkbox)",
              "hint": "Несколько вариантов, все видны сразу; реализует разработчик"
            },
            {
              "value": "select",
              "label": "Список (Select)",
              "hint": "Выпадающий список — компонент Select фреймворка"
            },
            { "value": "chips", "label": "Чипсы (Chips)", "hint": "Варианты-чипы; реализует разработчик" }
          ]
        },
        { "key": "required", "label": "Обязательность поля", "section": "Настройки" },
        { "key": "dynamicContent", "label": "Динамический контент", "section": "Настройки" },
        {
          "key": "complexLogic",
          "label": "Сложная логика",
          "section": "Настройки",
          "lockedWhen": [
            {
              "key": "dynamicContent",
              "equals": true,
              "value": false,
              "notice": "При включении динамического контента отсутствует возможность настройки сложной логики"
            }
          ]
        },
        { "key": "multiselect", "label": "Единичный выбор", "section": "Настройки", "invert": true },
        { "key": "search", "label": "Поиск", "section": "Настройки" },
        {
          "key": "optionsSource",
          "label": "Добавить список",
          "section": "Добавить список",
          "editor": "switches",
          "options": [
            { "value": "file", "label": "Файлом" },
            { "value": "manual", "label": "Вручную" },
            { "value": "text", "label": "Списком" }
          ]
        },
        {
          "key": "options",
          "view": "file",
          "label": "Вложение",
          "editor": "file",
          "item": { "id": "id", "label": "label" },
          "section": "Добавить список",
          "visibleWhen": { "key": "optionsSource", "equals": "file" }
        },
        {
          "key": "options",
          "view": "manual",
          "label": "",
          "item": { "id": "id", "label": "label" },
          "section": "Добавить список",
          "visibleWhen": { "key": "optionsSource", "equals": "manual" }
        },
        {
          "key": "options",
          "view": "text",
          "label": "",
          "editor": "text",
          "delimiter": ";",
          "placeholder": "Значение 1; Значение 2; Значение 3",
          "item": { "id": "id", "label": "label" },
          "section": "Добавить список",
          "visibleWhen": { "key": "optionsSource", "equals": "text" }
        }
      ]
    },
    {
      "kind": "radio-group",
      "label": "Radio group",
      "category": "Форма",
      "description": "Переключатели выбора значения (до 5 вариантов)",
      "card": { "title": "label" },
      "defaults": { "label": "Переключатели", "items": [] },
      "attributes": [
        { "key": "label", "label": "Название", "required": true, "placeholder": "Например, Срок вклада" },
        {
          "key": "items",
          "label": "Варианты выбора",
          "helperText": "Название варианта; значение для правил и переходов генерируется автоматически",
          "item": { "id": "value", "label": "label" }
        },
        { "key": "required", "label": "Обязательное поле", "section": "Настройки" }
      ]
    },
    {
      "kind": "typography",
      "label": "Typography",
      "category": "Форма",
      "description": "Текстовая вёрстка",
      "card": { "title": "label" },
      "defaults": { "label": "Заголовок", "variant": "h3" },
      "attributes": [
        { "key": "label", "label": "Текст", "required": true, "placeholder": "Например, Паспортные данные" },
        {
          "key": "variant",
          "label": "Стиль",
          "section": "Тип",
          "options": [
            { "value": "h1", "label": "Заголовок 1" },
            { "value": "h2", "label": "Заголовок 2" },
            { "value": "h3", "label": "Заголовок 3" },
            { "value": "h4", "label": "Заголовок 4" },
            { "value": "body1", "label": "Основной текст" },
            { "value": "body2", "label": "Основной текст, мелкий" },
            { "value": "caption1", "label": "Подпись" }
          ]
        }
      ]
    },
    {
      "kind": "button",
      "label": "Button",
      "category": "Форма",
      "description": "Кнопка действия",
      "card": { "title": "label" },
      "defaults": { "label": "Кнопка", "variant": "contained", "color": "secondary" },
      "attributes": [
        { "key": "label", "label": "Текст кнопки", "required": true, "placeholder": "Например, Отправить" },
        {
          "key": "variant",
          "label": "Вид",
          "section": "Тип",
          "options": [
            { "value": "contained", "label": "С заливкой" },
            { "value": "text", "label": "Текстовая" }
          ]
        },
        {
          "key": "color",
          "label": "Цвет",
          "section": "Тип",
          "options": [
            { "value": "primary", "label": "Основной" },
            { "value": "secondary", "label": "Вторичный" },
            { "value": "default", "label": "По умолчанию" }
          ]
        },
        { "key": "icon", "label": "Иконка" }
      ]
    },
    {
      "kind": "ac-configuration-item",
      "label": "CI picker",
      "category": "Форма",
      "description": "Выбор конфигурационной единицы",
      "card": { "title": "label" },
      "defaults": { "label": "Элемент конфигурации" },
      "attributes": [
        { "key": "label", "label": "Название", "required": true, "placeholder": "Например, Сервис" },
        {
          "key": "ciTypes",
          "label": "Типы КЕ",
          "helperText": "Тип на строку: as, autSystem, bizservice, environmenttype, fp, infresource"
        },
        { "key": "emptyResult", "label": "Текст пустого результата" },
        { "key": "helperText", "label": "Подсказка под полем" },
        { "key": "required", "label": "Обязательное поле", "section": "Настройки" },
        { "key": "multiple", "label": "Множественный выбор", "section": "Настройки" },
        { "key": "disabled", "label": "Отключено", "section": "Настройки" },
        { "key": "disableCloseOnSelect", "label": "Не закрывать при выборе", "section": "Настройки" }
      ]
    },
    {
      "kind": "ac-user-picker",
      "label": "Search user",
      "category": "Форма",
      "description": "Поиск сотрудника",
      "attributes": [
        { "key": "filter", "label": "Фильтр поиска" },
        { "key": "isReadonly", "label": "Только чтение", "section": "Настройки" }
      ]
    },
    {
      "kind": "ac-address-asun",
      "label": "Address ASUN",
      "category": "Форма",
      "description": "Выбор адреса (этаж, кабинет…)",
      "attributes": [
        { "key": "showFloor", "label": "Этаж" },
        { "key": "showRoom", "label": "Кабинет" },
        { "key": "showArea", "label": "Зона" },
        { "key": "showPlace", "label": "Рабочее место" },
        { "key": "required", "label": "Обязательное поле", "section": "Настройки" }
      ]
    },
    {
      "kind": "address",
      "label": "Address",
      "category": "Форма",
      "description": "Адрес (город, улица)",
      "card": { "title": "label" },
      "defaults": { "label": "Адрес" },
      "attributes": [
        { "key": "label", "label": "Название", "required": true, "placeholder": "Например, Адрес доставки" },
        { "key": "city", "label": "Город" },
        { "key": "showCurrentLocation", "label": "Текущее местоположение", "section": "Настройки" },
        { "key": "showLastAddress", "label": "Последний адрес", "section": "Настройки" },
        { "key": "required", "label": "Обязательное поле", "section": "Настройки" }
      ]
    },
    {
      "kind": "ac-autocomplete-login-sudir",
      "label": "Login",
      "category": "Форма",
      "description": "Поле логина сотрудника",
      "card": { "title": "label" },
      "defaults": { "label": "Логин сотрудника" },
      "attributes": [
        { "key": "label", "label": "Название", "required": true, "placeholder": "Например, Логин заявителя" },
        { "key": "required", "label": "Обязательное поле", "section": "Настройки" },
        { "key": "visible", "label": "Видимое поле", "section": "Настройки" }
      ]
    }
  ]
}
